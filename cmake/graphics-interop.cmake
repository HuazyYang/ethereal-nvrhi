# Graphics export companion; the CUDA importer remains in nvrhi::cuda.
if(NVRHI_BUILD_SHARED)
    set(nvrhi_graphics_interop_target nvrhi)
else()
    add_library(nvrhi_interop STATIC src/common/graphics-interop.cpp)
    set(nvrhi_graphics_interop_target nvrhi_interop)
    target_link_libraries(nvrhi_interop PUBLIC nvrhi)
    nvrhi_disable_rtti(nvrhi_interop)
    set_target_properties(nvrhi_interop PROPERTIES FOLDER "NVRHI")
    if(NVRHI_INSTALL)
        install(TARGETS nvrhi_interop EXPORT nvrhiTargets ARCHIVE DESTINATION lib)
    endif()
endif()
if(NVRHI_BUILD_SHARED)
    target_sources(nvrhi PRIVATE src/common/graphics-interop.cpp)
endif()
add_library(nvrhi::interop ALIAS ${nvrhi_graphics_interop_target})
target_compile_definitions(${nvrhi_graphics_interop_target} PRIVATE
    NVRHI_INTEROP_DX11=$<BOOL:${NVRHI_WITH_DX11}>
    NVRHI_INTEROP_DX12=$<BOOL:${NVRHI_WITH_DX12}>
    NVRHI_INTEROP_VULKAN=$<BOOL:${NVRHI_WITH_VULKAN}>)
foreach(backend d3d11 d3d12 vulkan)
    if(backend STREQUAL "d3d11")
        set(enabled ${NVRHI_WITH_DX11})
        set(backend_target ${nvrhi_d3d11_target})
    elseif(backend STREQUAL "d3d12")
        set(enabled ${NVRHI_WITH_DX12})
        set(backend_target ${nvrhi_d3d12_target})
    else()
        set(enabled ${NVRHI_WITH_VULKAN})
        set(backend_target ${nvrhi_vulkan_target})
    endif()
    if(enabled)
        target_sources(${backend_target} PRIVATE src/${backend}/${backend}-interop.cpp)
        if(NOT NVRHI_BUILD_SHARED)
            target_link_libraries(nvrhi_interop PUBLIC ${backend_target})
        endif()
    endif()
endforeach()
