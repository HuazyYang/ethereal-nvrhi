include(CMakeFindDependencyMacro)
find_dependency(Threads)  # nvrhi::core links Threads::Threads

# D3D12 exposes the DirectX header/GUID targets publicly. Static Vulkan consumers
# need Vulkan headers to provide the application-owned Vulkan-Hpp dispatcher.
if(@NVRHI_WITH_DX12@)
    find_dependency(directx-headers CONFIG)
endif()
if(@NVRHI_WITH_VULKAN@ AND NOT @NVRHI_BUILD_SHARED@)
    find_dependency(VulkanHeaders CONFIG)
endif()

if(@NVRHI_WITH_SLANG@ AND NOT @NVRHI_BUILD_SHARED@)
    find_dependency(ShaderTool CONFIG COMPONENTS Artifacts)
endif()
if(@NVRHI_WITH_CUDA@ AND NOT @NVRHI_BUILD_SHARED@)
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        # The static backend needs the Driver API at link time, but its public
        # headers expose no toolkit types. Resolve the installed driver directly
        # so runtime-only Linux consumers do not need the CUDA SDK.
        if(NOT TARGET CUDA::cuda_driver)
            find_library(nvrhi_CUDA_DRIVER_LIBRARY NAMES cuda libcuda.so.1)
            if(NOT nvrhi_CUDA_DRIVER_LIBRARY)
                set(nvrhi_FOUND FALSE)
                set(nvrhi_NOT_FOUND_MESSAGE "The static CUDA backend requires the NVIDIA driver library (libcuda.so.1)")
                return()
            endif()
            add_library(CUDA::cuda_driver UNKNOWN IMPORTED)
            set_target_properties(CUDA::cuda_driver PROPERTIES
                IMPORTED_LOCATION "${nvrhi_CUDA_DRIVER_LIBRARY}")
        endif()
    else()
        find_dependency(CUDAToolkit)
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/nvrhiTargets.cmake")

if(@NVRHI_WITH_CUDA@ AND NOT TARGET nvrhi::cuda)
    if(TARGET nvrhi_cuda)
        add_library(nvrhi::cuda ALIAS nvrhi_cuda)
    else()
        add_library(nvrhi::cuda ALIAS nvrhi)
    endif()
endif()

if(NOT TARGET nvrhi::interop)
    if(TARGET nvrhi_interop)
        add_library(nvrhi::interop ALIAS nvrhi_interop)
    else()
        add_library(nvrhi::interop ALIAS nvrhi)
    endif()
endif()
